<UserControl x:Class="DataField42.Views.News"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DataField42.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,10">
        <Border Background="#0d111c" BorderBrush="#233050" BorderThickness="1" Padding="14">
            <StackPanel>
                <!-- Shown while fetching, and when there is no post to show. -->
                <TextBlock Foreground="#d4d4d4" TextWrapping="Wrap" LineHeight="19"
                           Text="{Binding Status}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Foreground="#d4d4d4" TextWrapping="Wrap" LineHeight="19"
                                           Text="{Binding Text}"
                                           Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibility}}" />

                                <!-- Stays collapsed until the picture actually arrives, so a slot that
                                     never fills leaves no gap and a missing picture is invisible
                                     rather than a broken box. -->
                                <Border Margin="0,10,0,4" CornerRadius="3" ClipToBounds="True"
                                        BorderBrush="#233050" BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibility}}">
                                    <!-- Fills whatever width the window currently gives it, and
                                         shrinks to match when the window does. DownOnly is what stops
                                         a small picture being blown up past its real size to fill the
                                         space, which is the thing that actually looks bad; a 300px
                                         banner stays 300px and sharp.

                                         No MaxWidth, so maximising the window makes pictures bigger
                                         rather than leaving them stranded at a fixed size. Height is
                                         bounded only loosely, because the page scrolls; the only
                                         thing worth catching is a runaway portrait picture. -->
                                    <Image Source="{Binding Image}"
                                           Stretch="Uniform" StretchDirection="DownOnly"
                                           MaxHeight="900"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
