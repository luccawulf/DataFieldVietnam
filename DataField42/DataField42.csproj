<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- Output filename is DataFieldVietnam.exe. The in-game hook launches the client by this literal
         and the updater replaces a file by this name, so the hook asm (s_exe), the regenerated patch
         table, and DataField42 Updater's clientExeName all have to match it. The namespace/assembly
         identity stays DataField42 (invisible to users; renaming it is pure churn). -->
    <AssemblyName>DataFieldVietnam</AssemblyName>
    <Product>DataField Vietnam</Product>
    <AssemblyTitle>DataField Vietnam</AssemblyTitle>
    <Authors>LuccaWulf</Authors>
    <Description>DataField Vietnam — automatic map/mod downloader for Battlefield Vietnam. Based on DataField42 by Arklyiën.</Description>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <IsTrimmable>false</IsTrimmable>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="DotNetProjects.SVGImage" Version="5.2.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataField42.Core\DataField42.Core.csproj" />
    <ProjectReference Include="..\DF.Settings\DF.Settings.csproj" />
  </ItemGroup>

</Project>
